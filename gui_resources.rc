#include <winres.h>
#include "include/resource.h"

IDI_APP_ICON        ICON    "icon.ico"
IDR_APP_PNG         RCDATA  "icon.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,7,0
PRODUCTVERSION  1,0,7,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Hemera Project"
            VALUE "FileDescription",  "Hemera"
            VALUE "FileVersion",      "1.0.7.0"
            VALUE "InternalName",     "Hemera"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Hemera Project. All rights reserved."
            VALUE "OriginalFilename", "Hemera.exe"
            VALUE "ProductName",      "Hemera"
            VALUE "ProductVersion",   "1.0.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
