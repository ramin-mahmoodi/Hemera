# Root build outputs
/build/
/bin/
/obj/
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.map
*.idb
*.tlog
*.log
*.res
*.obj

# Libraries (ignore all except core/vendor static libs)
*.lib
!core/vendor/**/*.lib

# Vendor build intermediates to ignore
core/vendor/**/build/CMakeFiles/
core/vendor/**/build/**/.*
core/vendor/**/build/**/*.ninja
core/vendor/**/build/**/*.cmake
core/vendor/**/build/**/*.manifest
core/vendor/**/build/**/*.txt
core/vendor/**/build/**/*.obj
core/vendor/**/build/**/*.pdb
core/vendor/**/build/**/*.pc
core/vendor/**/build/bssl.exe
core/vendor/**/build/examples/
core/vendor/**/build/tests/

# Keep essential vendor build headers and libraries
!core/vendor/**/build/lib/includes/**/*.h
!core/vendor/**/build/**/*.lib

# Tests & Binaries (as requested)
tests/
binaries/*
!binaries/wintun.dll
!binaries/x64/
!binaries/x64/**
!binaries/arm64/
!binaries/arm64/**
resources.rc
spike/
core/spike/

# Secrets and private config files
*.toml
*.pem
*.key

# IDE and Editor files
.vs/
.vscode/
*.user
*.suo
*.sln.docstates

# Unused or non-essential vendor submodules/bloat
core/vendor/msquic/
core/vendor/tools/
core/vendor/boringssl/crypto/
core/vendor/boringssl/ssl/
core/vendor/boringssl/third_party/
core/vendor/boringssl/decrepit/
core/vendor/boringssl/fuzz/
core/vendor/boringssl/gen/
core/vendor/boringssl/infra/
core/vendor/boringssl/pki/
core/vendor/boringssl/rust/
core/vendor/boringssl/tool/
core/vendor/boringssl/util/
core/vendor/nghttp2/examples/
core/vendor/nghttp2/tests/
core/vendor/nghttp2/src/
core/vendor/nghttp2/doc/
core/vendor/nghttp3/examples/
core/vendor/nghttp3/tests/
core/vendor/ngtcp2/examples/
core/vendor/ngtcp2/tests/

# Scratch & temporary artifacts
entry_*.png
cropped_screenshot.png
build_icons.py
test_*.py
check_*.py
graphify-out/
startup.log
crash_report.txt
hemera_engine.log
